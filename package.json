{
    "name": "taiwan-equity-quant-tool",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node scripts/start-local.mjs",
        "dev": "node scripts/start-local.mjs",
        "build:bootstrap": "sass --style=compressed --no-source-map --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function styles/bootstrap-twetq.scss public/vendor/bootstrap-twetq.min.css",
        "verify:bootstrap-ui": "node scripts/verify-bootstrap-ui.mjs",
        "check": "npm run build:bootstrap && node --check src/worker.js && node --check public/sw.js && node --check public/vue-shell.js && node --check public/bootstrap-loader.js && node --check public/bootstrap-adapter.js && node --check public/staging-reference.js && node --check scripts/start-local.mjs",
        "bot": "node scripts/bots/index.mjs",
        "bot:market": "node scripts/bots/market-bot.mjs",
        "bot:financial": "node scripts/bots/financial-bot.mjs",
        "bot:institutional": "node scripts/bots/institutional-bot.mjs",
        "bot:podcast": "node scripts/bots/podcast-bot.mjs",
        "bot:screener": "node scripts/bots/screener-bot.mjs",
        "bot:kline": "node scripts/bots/kline-bot.mjs",
        "bot:refresh": "node scripts/bots/data-refresh-bot.mjs",
        "bot:verify": "node scripts/bots/verification-bot.mjs"
    },
    "devDependencies": {
        "sass": "^1.102.0",
        "wrangler": "^4.156.0"
    },
    "dependencies": {
        "bootstrap": "5.3.8",
        "vue": "3.5.40"
    }
}